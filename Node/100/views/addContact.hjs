<form method="post" action="{{formAction}}" class="contact-form">
    <input type="hidden" name="id" value="{{contact.id}}" />

    <div class="form-group">
        <label>First</label>
        <input name="first" value="{{contact.first}}" />
    </div>

    <div class="form-group">
        <label>Last</label>
        <input name="last" value="{{contact.last}}" required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input name="email" type="email" value="{{contact.email}}" />
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input name="phone" value="{{contact.phone}}" />
    </div>

    <div class="button-group">
        <button type="submit" class="btn primary form-btn">Save</button>
        <a href="/" class="btn cancel form-btn">Cancel</a>
    </div>
</form>