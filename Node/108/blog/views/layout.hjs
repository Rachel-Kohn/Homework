<!DOCTYPE html>
<html>

<head>
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <header>
    <h1>{{ title }}</h1>

    <nav>
      <a href="/">Posts</a> |
      <a href="/addPost">Add Post</a>

      {{#user}}
      | <span>Hi {{username}}</span>
      | <a href="/logout">Logout</a>
      {{/user}}

      {{^user}}
      | <a href="/login">Login</a>
      | <a href="/register">Register</a>
      {{/user}}
    </nav>
  </header>

  <main>
    {{> content}}
  </main>

</body>

</html>